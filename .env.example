# SanketSetu Environment Configuration
# Copy to .env for local development. Never commit secrets.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Persistence (defaults to ./data/sanketsetu.db SQLite file)
DATABASE_URL=./data/sanketsetu.db

# Authentication & Security
SESSION_SECRET=
EXPERT_APPROVAL_SECRET=
ALLOWED_ORIGIN=http://localhost:3000

# Development Demo Account Seeding (only active when NODE_ENV !== 'production')
SEED_DEMO_ACCOUNTS=true

# External Weather & AI APIs
# Open-Meteo gridded estimates are used; direct IMD station data is not queried by this service.
IMD_API_KEY=
GEMINI_API_KEY=
# Set these to currently supported Google AI Studio model IDs for your account.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_HISTORY_MESSAGES=20

# Optional TomTom traffic flow key; live status requires recent successful flow responses.
TOMTOM_API_KEY=